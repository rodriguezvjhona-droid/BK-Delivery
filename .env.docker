# ==========================================
# BK DELIVERY - ENTORNO DOCKER COMPOSE
# Usar: docker-compose --env-file .env.docker up
# ==========================================

PORT=4000
NODE_ENV=production

# PostgreSQL (nombre del servicio interno en Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bk_delivery
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_SECRET=bk_delivery_super_secret_jwt_key_2026_enterprise_secure!
JWT_EXPIRES_IN=24h

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Redis (nombre del servicio interno en Docker)
REDIS_HOST=redis
REDIS_PORT=6379

BUSINESS_NAME=BK Delivery - Sabores Alemanes & Gourmet
BUSINESS_NIT=901.458.789-2
BUSINESS_ADDRESS=Calle 45 # 18-32, Bucaramanga, Santander
BUSINESS_PHONE=+57 312 456 7890
BUSINESS_TAX_RATE=0.08
BUSINESS_CURRENCY=COP
