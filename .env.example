# ==========================================
# BK DELIVERY - CONFIGURACIÓN DE ENTORNO
# ==========================================

# Puerto de la API Backend NestJS
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bk_delivery
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticación JWT
JWT_SECRET=bk_delivery_super_secret_jwt_key_2026_enterprise_secure!
JWT_EXPIRES_IN=24h

# Configuración de Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Redis (Caché y colas)
REDIS_HOST=localhost
REDIS_PORT=6379

# Facturación e Impresión
BUSINESS_NAME=BK Delivery - Sabores Alemanes & Gourmet
BUSINESS_NIT=901.458.789-2
BUSINESS_ADDRESS=Calle 45 # 18-32, Bucaramanga, Santander
BUSINESS_PHONE=+57 312 456 7890
BUSINESS_TAX_RATE=0.08
BUSINESS_CURRENCY=COP
